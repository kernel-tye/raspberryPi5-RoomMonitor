# Copy to ~/cctv/cctv.env on the Pi. Every line is optional; the defaults are shown.
# Read by cctv-recorder / cctv-web / cctv-baidu-sync through EnvironmentFile=.

# Data directory (segments, events, logs, passwords)
#CCTV_HOME=/home/pi/cctv

# Address the web viewer binds to. Use a private address such as your Tailscale IP.
#CCTV_WEB_LISTEN=127.0.0.1:8090

# MQTT topic (local mosquitto) whose "START" message marks a door-open event
#CCTV_MQTT_TOPIC=cctv/door

# BaiduPCS-Go binary and the Netdisk folder uploads go to
#CCTV_BPCS=/home/pi/bin/BaiduPCS-Go
#CCTV_REMOTE=/房间监控

# Older door-sensor recordings (*.mp4) to upload after everything else
#CCTV_OLD_DIR=/home/pi/ai_cam_records_private
